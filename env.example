# ROLV API — grounded mode (with RAG, with pre-exec planner)
ROLV_API_URL=https://api.rolv.io/api/chat/completions
ROLV_JWT_TOKEN=<your ROLV JWT token>

# ROLV raw mode — no RAG, no system prompt augmentation (get from Arash)
# If not set, falls back to ROLV_API_URL / ROLV_JWT_TOKEN with no_domain=true
ROLV_RAW_API_URL=https://api.rolv.io/api/chat/completions
ROLV_RAW_API_KEY=<raw mode key from Arash>

# Groq — free at https://console.groq.com/keys
GROQ_API_KEY=<your Groq key>

# Google Gemini — needs billing enabled on Google Cloud
GOOGLE_API_KEY=<your Google API key>

# OpenAI — needed for Codex CLI (optional)
OPENAI_API_KEY=<your OpenAI key>

# Anthropic — needed for Claude Code CLI (optional)
ANTHROPIC_API_KEY=<your Anthropic key>

# R executable path
R_EXEC=C:/Program Files/R/R-4.5.1/bin/Rscript.exe

# Dataset directory — point to the folder containing barcodes.tsv.gz, genes.tsv.gz, matrix.mtx.gz
BENCH_DATASET_DIR=C:/MDC_internship/rolvdesktop/rolvdesktop_electron/benchmark/datasets/filtered_gene_bc_matrices/hg19
