# Copy this file to .env in the repository root and fill in the values.
# Run the benchmark scripts from the repository root so that .env is found.

# --- Model providers (only the keys for the models you run are needed) -------
OPENAI_API_KEY=<your key>          # gpt-5.5, gpt-5.4-mini
OPENROUTER_API_KEY=<your key>      # gemini-openrouter, gemini-flash-lite
ANTHROPIC_API_KEY=<your key>       # claude-opus-4-8, claude-sonnet-5, claude-haiku-4-5

# --- Agentic RAG (ROLV) ------------------------------------------------------
ROLV_API_URL=https://api.rolv.io/api/chat/completions
ROLV_JWT_TOKEN=<your token>
# Path to lib/core/orchestrator.js inside a local checkout of the ROLV desktop app
ROLV_ORCHESTRATOR_PATH=<path to rolvdesktop_electron/lib/core/orchestrator.js>

# --- R and data --------------------------------------------------------------
# Rscript executable. Leave unset to use the Rscript found on PATH.
# R_EXEC=C:/Program Files/R/R-4.5.1/bin/Rscript.exe
# Folder with barcodes.tsv, genes.tsv and matrix.mtx.
# Leave unset to use data/pbmc3k/filtered_gene_bc_matrices/hg19 in this repository.
# BENCH_DATASET_DIR=

# --- Coding-agent benchmark --------------------------------------------------
# Attempts per prompt (default 1; the runs in results/ used 3).
BENCH_K=3
# CODEX_MODEL=gpt-5.6-terra
# GEMINI_MODEL=gemini-3.5-flash
# Key for the Gemini CLI when it is not logged in (e.g. inside Docker).
# GEMINI_API_KEY=

# --- API Skills condition ----------------------------------------------------
# Maximum number of view() tool turns before a final answer is forced (default 12).
# BENCH_MAX_TOOL_TURNS=12